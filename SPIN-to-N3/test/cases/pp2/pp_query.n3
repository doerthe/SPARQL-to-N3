## construct
{   ?x <= ?y ; a sp:Construct .
    
    ?x :graphToList ?temps .
    ?y :graphToList ?where .
   ( false ?where ) aux:createGraph ?g1 .
   ( false ?temps ) aux:handleTriples ?g2 
}
=> 
{
   ?g1 => ?g2 .
} .