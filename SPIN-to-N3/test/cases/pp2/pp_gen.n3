# to run the test:
# eye test/cases/pp2/pp_gen.n3  test/cases/pp2/test8-data.n3 --nope --pass-only-new

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix skolem: <https://eyereasoner.github.io/.well-known/genid/787cb490-1f7d-4d4c-a644-da9bf8eb000c#>.
PREFIX sin3: <https://notation3.org/sin3#>
@prefix : <http://example.org/> .

{
    ?t_5 ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?t_6.
} => {
    ?t_5 <http://example.org/result> ?t_6.
} .

{
    ?t_5 ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?t_5.
} <= {
    # else, get results like
    # _:sk_0 :result _:sk_0.
    # but, I don't know how to properly implement it.
    ?t_5 sin3:isVariable false .
} .

# {
#     ?t_5 ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?t_6.
# } <= {
#     ?t_5 <http://example.org/p1> ?t_7.
#     ?t_7 <http://example.org/p2> ?t_6.
# }.
# {
#     ?t_5 ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?t_6.
# } <= {
#     ?t_5 <http://example.org/p1> ?t_8.
#     ?t_8 <http://example.org/p2> ?t_9.
#     ?t_9 ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?t_6.
# }.

{
    ?c ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?r.
} <= {
    ?c <http://example.org/p1> ?t_7.
    ?t_7 <http://example.org/p2> ?n.

    ?n ('ctu' (<http://example.org/p1> "/" <http://example.org/p2>) "*") ?r.
} .

{ 
    ?n ('ctu' (<http://example.org/p1> "/" <http://example.org/p2>) "*") ?n
} <= {} .

{ 
    ?n ('ctu' (<http://example.org/p1> "/" <http://example.org/p2>) "*") ?r
} <= {
    ?n ((<http://example.org/p1> "/" <http://example.org/p2>) "*") ?r
} .

{?p sin3:isVariable false}<={?p log:rawType ?t. ?t log:notEqualTo  log:ForAll.}.